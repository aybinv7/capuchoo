# Network resilience. This workspace pulls a large dependency graph (three.js,
# unovis, the Capacitor toolchain), and the default 60s fetch timeout aborts the
# whole install on a slow link. Fewer parallel sockets is faster on a slow
# connection, not slower.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-concurrency=4
