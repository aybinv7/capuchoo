{
  "name": "@capuchoo/server",
  "version": "1.0.0",
  "private": true,
  "description": "Capuchoo update server: devices, releases, channels, builds and the dashboard, over PostgreSQL",
  "license": "MIT",
  "author": "aybinv7",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "start": "node --enable-source-maps dist/main.mjs",
    "migrate": "node --enable-source-maps dist/migrate.mjs",
    "admin": "node --enable-source-maps dist/admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "dependencies": {
    "@capuchoo/core": "workspace:^",
    "@hono/node-server": "^2.1.3",
    "aws4fetch": "^1.0.20",
    "busboy": "^1.6.0",
    "hono": "^4.13.11",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/busboy": "^1.5.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "kysely-pglite-dialect": "^1.3.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
