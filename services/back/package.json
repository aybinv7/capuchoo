{
  "name": "@capucho/back",
  "version": "1.0.0",
  "description": "Capucho update server - apps, channels, bundles, native releases",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "dev:debug": "nodemon --inspect --exec ts-node-dev -r tsconfig-paths/register src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "capacitor",
    "capgo",
    "updates",
    "self-hosted",
    "mobile",
    "app"
  ],
  "_moduleAliases": {
    "@": "dist"
  },
  "author": "aybinv7",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "semver": "^7.5.4",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.5",
    "@types/semver": "^7.5.0",
    "nodemon": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "private": true
}
