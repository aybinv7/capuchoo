# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Supabase replaced its JWT keys: `anon` became the publishable key and
# `service_role` became the secret key. Supabase's own documentation states the
# legacy pair "will be deprecated by the end of 2026". Create both in the
# dashboard under Settings > API Keys.
#
# SUPABASE_SECRET_KEY (sb_secret_...) holds the BYPASSRLS attribute: full access
# to the project, ignoring row level security. It belongs only in the server
# environment (Render/host secrets), never in a client bundle, never in a
# repository. This server requires it - every write it performs targets a table
# with RLS enabled, and a publishable key's writes there are rejected.
#
# SUPABASE_PUBLISHABLE_KEY (sb_publishable_...) is safe to expose and is not
# used by this service; it is accepted so one place describes both keys.

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Deprecated aliases, still accepted so an environment can be migrated without a
# deploy in between. SUPABASE_KEY was the anon JWT, SUPABASE_SERVICE_KEY the
# service_role JWT. Remove them once the new keys are set - and remember that
# creating new keys does not disable the old ones: delete the legacy keys in the
# dashboard, or they remain valid.
# SUPABASE_KEY=
# SUPABASE_SERVICE_KEY=

BUCKET_NAME=
STORAGE_BASE_URL=

PORT=3000
ENVIRONMENT=development
