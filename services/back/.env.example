# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# SUPABASE_SERVICE_KEY is a service-role key: it bypasses row level security
# entirely. It belongs only in the server environment (Render/host secrets),
# never in a client bundle, never in a repository.

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

BUCKET_NAME=
STORAGE_BASE_URL=

PORT=3000
ENVIRONMENT=development
