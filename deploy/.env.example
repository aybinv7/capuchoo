# Copy to deploy/.env and fill in. Never commit the filled file.

# The hostname devices and the dashboard use, pointed at this VPS (A/AAAA record). It is compiled
# into every APK, so pick one you will keep.
CAPUCHOO_HOST=updates.example.com
# Let's Encrypt registration and expiry notices.
ACME_EMAIL=ops@example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48 - signs download links and encrypts stored secrets; never rotate casually.
SECRET_KEY=

# First instance admin on an empty database; remove both once you have signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Postgres is published on 127.0.0.1 only; reach it through an SSH tunnel.
POSTGRES_PORT=5432

# fs keeps artefacts on the artefacts volume; s3 for MinIO or R2.
STORAGE_DRIVER=fs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma list of GitLab hosts on a private network, for CI pipelines.
GITLAB_ALLOWED_HOSTS=

LOG_LEVEL=info
TRAEFIK_LOG_LEVEL=WARN
BACKUP_KEEP_DAYS=14
