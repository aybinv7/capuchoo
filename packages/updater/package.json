{
  "name": "@capuchoo/updater",
  "version": "0.6.1",
  "description": "App-side runtime for Capucho OTA and native updates in Capacitor apps",
  "keywords": [
    "capacitor",
    "capucho",
    "live-update",
    "ota",
    "vue"
  ],
  "homepage": "https://github.com/aybinv7/capuchoo/tree/main/packages/updater",
  "license": "MIT",
  "author": "aybinv7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/capuchoo.git",
    "directory": "packages/updater"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./capacitor": {
      "types": "./dist/capacitor-config.d.ts",
      "default": "./dist/capacitor-config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test --run"
  },
  "dependencies": {
    "@capuchoo/core": "workspace:^"
  },
  "devDependencies": {
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/file-transfer": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/network": "catalog:",
    "@capawesome-team/capacitor-file-opener": "catalog:",
    "@capgo/capacitor-updater": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@capacitor/app": ">=7.0.0 <9.0.0",
    "@capacitor/core": ">=7.0.0 <9.0.0",
    "@capacitor/device": ">=7.0.0 <9.0.0",
    "@capacitor/file-transfer": ">=1.0.12 <3.0.0",
    "@capacitor/filesystem": ">=7.0.0 <9.0.0",
    "@capacitor/network": ">=7.0.0 <9.0.0",
    "@capawesome-team/capacitor-file-opener": ">=7.0.0 <9.0.0",
    "@capgo/capacitor-updater": ">=7.0.0 <9.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/file-transfer": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capacitor/network": {
      "optional": true
    },
    "@capawesome-team/capacitor-file-opener": {
      "optional": true
    },
    "@capacitor/device": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
