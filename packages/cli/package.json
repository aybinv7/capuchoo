{
  "name": "capucho-cli",
  "version": "0.2.0",
  "description": "Builds and publishes OTA and native releases for Capacitor applications through Capucho.",
  "license": "MIT",
  "author": "aybinv7",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "capucho": "./bin/run.js",
    "capucho-cli": "./bin/run.js"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": "aybinv7/capucho",
  "homepage": "https://github.com/aybinv7/capucho/tree/main/packages/cli",
  "bugs": "https://github.com/aybinv7/capucho/issues",
  "keywords": [
    "capacitor",
    "ota",
    "deploy",
    "oclif",
    "capucho"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "vp test --run",
    "prepack": "oclif manifest",
    "postpack": "node -e \"require('node:fs').rmSync('oclif.manifest.json',{force:true})\""
  },
  "dependencies": {
    "@capucho/core": "workspace:*",
    "@inquirer/prompts": "^8.1.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5.6.2",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oclif": "^4",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "oclif": {
    "bin": "capucho",
    "dirname": "capucho",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "auth": {
        "description": "Sign in to a Capucho backend"
      },
      "deploy": {
        "description": "Build and publish a release"
      },
      "channel": {
        "description": "Inspect an app's channels"
      },
      "config": {
        "description": "Inspect resolved configuration and detected tools"
      },
      "version": {
        "description": "Manage the app version and native build numbers"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
