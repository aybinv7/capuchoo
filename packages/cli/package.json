{
  "name": "@capuchoo/cli",
  "version": "0.11.2",
  "description": "Builds and publishes OTA and native releases for Capacitor applications through Capucho.",
  "keywords": [
    "capacitor",
    "capuchoo",
    "deploy",
    "oclif",
    "ota"
  ],
  "homepage": "https://github.com/aybinv7/capuchoo/tree/main/packages/cli",
  "bugs": "https://github.com/aybinv7/capuchoo/issues",
  "license": "MIT",
  "author": "aybinv7",
  "repository": "aybinv7/capuchoo",
  "bin": {
    "capuchoo": "./bin/run.js"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --force",
    "test": "vp test --run",
    "readme": "oclif readme",
    "prepack": "oclif manifest",
    "postpack": "node -e \"require('node:fs').rmSync('oclif.manifest.json',{force:true})\""
  },
  "dependencies": {
    "@capuchoo/core": "workspace:^",
    "@clack/prompts": "catalog:",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5.6.2",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oclif": "^4",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "oclif": {
    "bin": "capuchoo",
    "commands": "./dist/commands",
    "dirname": "capuchoo",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "app": {
        "description": "List and delete apps, and manage who can publish"
      },
      "auth": {
        "description": "Sign in, and manage this account's API keys"
      },
      "channel": {
        "description": "Create and inspect an app's channels"
      },
      "config": {
        "description": "Inspect resolved configuration and detected tools"
      },
      "deploy": {
        "description": "Build and publish a release"
      },
      "org": {
        "description": "Create organizations and manage who is in them"
      },
      "version": {
        "description": "Manage the app version and native build numbers"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
