{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  // oclif discovers commands by walking ./dist/commands, one module per
  // command, so this package is compiled with tsc rather than bundled with
  // `vp pack` - a bundler would collapse those modules into one file.
  //
  // @capucho/core is resolved through its workspace link to packages/core/dist,
  // which `vp run -r build` builds first because the dependency is declared.
  "include": ["src/**/*.ts"],
  // Tests run through `vp test`, which compiles them itself. Keeping them out
  // of the build means dist/ holds only shippable code.
  "exclude": ["src/**/*.test.ts"]
}
