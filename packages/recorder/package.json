{
  "name": "@capuchoo/recorder",
  "version": "0.1.0",
  "description": "Session recording for Capacitor apps: replay, console, network, performance, telemetry and SQLite changesets, streamed to Capuchoo from a worker",
  "keywords": [
    "capacitor",
    "capucho",
    "rrweb",
    "session-replay",
    "telemetry"
  ],
  "homepage": "https://github.com/aybinv7/capuchoo/tree/main/packages/recorder",
  "license": "MIT",
  "author": "aybinv7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/capuchoo.git",
    "directory": "packages/recorder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./updater": {
      "types": "./dist/updater.d.ts",
      "default": "./dist/updater.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "dependencies": {
    "@capuchoo/core": "workspace:^",
    "@rrweb/record": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@capuchoo/updater": "workspace:^",
    "@rrweb/types": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@capuchoo/updater": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@capuchoo/updater": {
      "optional": true
    }
  }
}
