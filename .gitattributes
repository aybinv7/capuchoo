# Normalise line endings so Windows and CI agree on file hashes.
* text=auto eol=lf

# Scripts that break if they ever gain CRLF.
gradlew text eol=lf
*.sh text eol=lf

# Windows-only entry points.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.keystore binary
*.jar binary
*.apk binary
*.aab binary
*.xlsx binary

# Lockfiles: keep diffs out of review noise.
pnpm-lock.yaml linguist-generated=true -diff
