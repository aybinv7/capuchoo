{
  "name": "@capucho/template",
  "private": true,
  "type": "module",
  "version": "19.0.0",
  "description": "Reference Capacitor application wired to Capucho updates",
  "repository": {
    "type": "git",
    "url": "https://github.com/inventor7/Capucho.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "dev:staging": "dotenv -e build/staging/.env.staging -e .env.local -- vp dev --host 0.0.0.0",
    "dev:prod": "dotenv -e build/prod/.env.prod -e .env.local -- vp dev --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vp build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vp preview --port 4173",
    "test": "echo \"no tests yet\" && exit 0",
    "build:staging": "dotenv -e build/staging/.env.staging -- vp build --mode staging",
    "build:prod": "dotenv -e build/prod/.env.prod -- vp build --mode prod",
    "build:dev": "dotenv -e build/dev/.env.dev -- vp build --mode dev",
    "deploy": "capucho deploy ota",
    "deploy:native": "capucho deploy native"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "catalog:",
    "@capacitor/device": "catalog:",
    "@capacitor/file-transfer": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "catalog:",
    "@capacitor/preferences": "catalog:",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome-team/capacitor-file-opener": "catalog:",
    "@capgo/capacitor-updater": "catalog:",
    "@openreplay/tracker": "^17.0.1",
    "@openreplay/tracker-assist": "^11.0.10",
    "@openreplay/tracker-vuex": "^4.0.3",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.66.0",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom7": "^4.0.6",
    "firebase": "^12.8.0",
    "framework7": "^9.0.2",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^8.3.4",
    "js-logger": "^1.6.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "skeleton-elements": "^4.0.1",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2",
    "@capucho/core": "workspace:*",
    "@capucho/updater": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "catalog:",
    "@iconify-json/f7": "^1.2.2",
    "@iconify-json/lucide": "^1.2.80",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@trapezedev/configure": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.25",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "less": "^4.4.2",
    "npm-run-all": "^4.1.5",
    "postcss-preset-env": "^10.5.0",
    "prettier": "^3.7.4",
    "three": "^0.182.0",
    "typescript": "catalog:",
    "unplugin-icons": "^22.5.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^2.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.8",
    "capucho-cli": "workspace:*",
    "@capacitor/assets": "catalog:"
  }
}
