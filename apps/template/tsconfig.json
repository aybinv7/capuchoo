{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "./typed-router.d.ts",
    "vite.config.ts",
    "src/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // No baseUrl: since TypeScript 4.4 `paths` resolve relative to the
    // tsconfig when it is absent, which is both equivalent here and what
    // TypeScript 7 requires.
    "paths": {
      "@/*": ["./src/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/shared/*": ["./src/shared/*"]
    },
    "allowJs": true,
    "types": [
      "node",
      "@intlify/unplugin-vue-i18n/messages",
      "./auto-imports.d.ts",
      "./components.d.ts",
      "unplugin-icons/types/vue",
      "./env.d.ts",
      "vite/client"
    ]
  }
}
